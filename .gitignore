# build output
dist/
# scratch space for build scripts — the Natural Earth download the regions
# script caches, and anything else that can be regenerated by re-running a
# script in scripts/
.tmp/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.local
.env.production
.env.*.local

# Source material from the client. The staff introductions PDF carries real
# phone numbers, email addresses, and social handles for fourteen people, so
# none of it belongs in version control. What the site actually uses was
# copied out into scripts/staff.mjs, biography only.
content/

# The same rule for the edit rounds the client sends in: the Word documents
# and the Code of Ethics PDF stay out, and what the site uses is transcribed
# into scripts/client-copy.mjs and seeded into Sanity from there.
edits/

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/
