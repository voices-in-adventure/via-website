---
// A place or a reason on the Journeys landing page. Not an article, so not
// ArticleCard — there is no photo, no byline, and no date. What a reader
// needs in order to pick one is the name, what it covers, and whether there
// is anything in it yet.
//
// The count is shown even when it is zero. A tag with nothing in it is a real
// state of this site, and saying so is more useful than an unmarked link that
// leads somewhere empty.
//
// The hover is the house scribble, same as ArticleCard, so the two kinds of
// card on the site behave identically under the cursor.
import Scribble from './Scribble.astro'
import {storyCountLabel} from '../lib/articles'

interface Props {
  href: string
  title: string
  description?: string | null
  count: number
  /** A place's region color slug. Omitted for reasons. */
  color?: string | null
}

const {href, title, description, count, color} = Astro.props

const countLabel = storyCountLabel(count)
---

<article class="tag-card" data-color={color ?? undefined}>
  <a class="tag-card-link" href={href} data-scribble>
    <h3 class="tag-card-title">
      <span class="tag-card-title-text">{title}<Scribble /></span>
    </h3>
    {description && <p class="tag-card-description">{description}</p>}
    <p class="tag-card-count">{countLabel}</p>
  </a>
</article>

<style>
  /*
    The region color rides the top rule. It identifies which of the six
    regions this is — the name is spelled out directly underneath, so the
    color never carries the meaning on its own. Reasons have no region and
    take the neutral rule.
  */
  .tag-card {
    border-top: 3px solid var(--tag-color, var(--fg));
  }

  .tag-card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--space-6) 0 var(--space-8);
    background-image: none;
  }

  .tag-card-title {
    margin: 0 0 var(--space-3);
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: 1.25;
    color: var(--fg);
  }

  .tag-card-title-text {
    position: relative;
    display: inline-block;
    --scribble-height: 0.7em;
    --scribble-drop: -0.16em;
  }

  .tag-card-description {
    margin: 0 0 var(--space-6);
    font-family: var(--font-serif);
    font-size: var(--text-base);
    line-height: 1.5;
    color: var(--muted);
  }

  /* Pushed to the bottom so counts line up across a row of uneven descriptions. */
  .tag-card-count {
    margin: auto 0 0;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--muted);
  }

  [data-color='europe'] {
    --tag-color: var(--tag-europe);
  }
  [data-color='asia'] {
    --tag-color: var(--tag-asia);
  }
  [data-color='americas'] {
    --tag-color: var(--tag-americas);
  }
  [data-color='africa'] {
    --tag-color: var(--tag-africa);
  }
  [data-color='oceania'] {
    --tag-color: var(--tag-oceania);
  }
  [data-color='mideast'] {
    --tag-color: var(--tag-mideast);
  }
</style>
