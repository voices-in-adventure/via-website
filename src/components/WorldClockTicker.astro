---
// The homepage's signature element — a live readout, not decoration. See
// docs/via-design.md: "Live, not static. Mono only. It sits at the bottom
// edge of the hero." Cities come from the pages that call this component,
// which pull them from actually-published Dispatches — never hardcoded.
//
// This is the one place on the site that needs a client-side script: a
// clock has to keep running after the page loads.
import {getTimezoneForCity, getUtcOffsetMinutes} from '../lib/cityTimezones'

interface Props {
  cities: string[]
}

const {cities} = Astro.props

// Ordered west to east, like a wall of office clocks. Publication order would
// be arbitrary here; longitude is the thing a reader can actually follow.
// A city missing from src/lib/cityTimezones.ts is skipped entirely — a clock
// with no time reads as broken.
const items = cities
  .map((city) => ({city, timezone: getTimezoneForCity(city)}))
  .filter((item): item is {city: string; timezone: string} => item.timezone !== null)
  .sort((a, b) => getUtcOffsetMinutes(a.timezone) - getUtcOffsetMinutes(b.timezone))
---

<div class="ticker" role="group" aria-label="Current local time in cities VIA has published about">
  {
    items.map(({city, timezone}) => (
      <div class="ticker-item" data-city={city}>
        <span class="ticker-city">{city}</span>
        <time class="ticker-time" data-tz={timezone}>
          --:--:--
        </time>
      </div>
    ))
  }
</div>

<style>
  /*
    space-between spreads the readout across the full width it is given. The
    homepage now sends six cities, which is what makes the row actually reach
    both edges rather than sitting as three widely-spaced items. It stays
    honest at any count: the first item is always flush left, the last always
    flush right.
  */
  .ticker {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-8);
    width: 100%;
    padding: var(--space-4) var(--gutter);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--bg);
  }

  .ticker-item {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    white-space: nowrap;
  }

  .ticker-city {
    text-transform: uppercase;
  }

  .ticker-time {
    /* Slightly quieter than the city name so the row reads as label + value,
       not as two competing pieces of information. */
    color: color-mix(in srgb, var(--bg) 78%, transparent);
    font-variant-numeric: tabular-nums;
  }

  /*
    Six clocks need about 900px before they start touching. Rather than
    shrinking the type or letting the row wrap into a block — either of which
    stops it reading as a departures board — the tail is dropped a clock at a
    time. The cities are already ordered west to east, so what survives at the
    narrowest width is still a spread of the world and not one corner of it.

    Kept as display: none rather than a smaller server-rendered count because
    the count is a layout question, and layout questions belong in CSS where
    they can answer to the actual viewport.
  */
  @media (max-width: 1100px) {
    .ticker-item:nth-child(n + 5) {
      display: none;
    }
  }

  @media (max-width: 820px) {
    .ticker-item:nth-child(n + 4) {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .ticker-item:nth-child(n + 3) {
      display: none;
    }
  }
</style>

<script>
  function updateTicker() {
    const now = new Date()
    document.querySelectorAll<HTMLElement>('.ticker-time[data-tz]').forEach((el) => {
      const timeZone = el.dataset.tz
      if (!timeZone) return
      try {
        el.textContent = new Intl.DateTimeFormat('en-US', {
          timeZone,
          hour: '2-digit',
          minute: '2-digit',
          second: '2-digit',
          hour12: false,
        }).format(now)
      } catch {
        // Unknown/invalid IANA zone — leave the placeholder rather than throw.
      }
    })
  }

  updateTicker()
  setInterval(updateTicker, 1000)
</script>
