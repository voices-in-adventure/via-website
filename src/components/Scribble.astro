---
// The hover underline: a hand-drawn stroke that draws itself in, echoing the
// pen the VIA logo was made with.
//
// How to use it: put this inside the element you want underlined, give that
// element `data-scribble`, `position: relative`, and `display: inline-block`.
// The stroke sizes itself to that element's width.
//
// Two knobs, both optional, set as CSS custom properties on the host:
//   --scribble-height  how tall the stroke box is (default 0.5em)
//   --scribble-drop    how far below the text it sits (default 0)
//
// Deliberately NOT used on links inside article prose — see
// components/portable/BodyLink.astro for why those stay a plain rule.
import {SCRIBBLE_PATHS, SCRIBBLE_VIEWBOX} from '../lib/scribbles'
---

{/*
  preserveAspectRatio="none" is the point: the stroke stretches to whatever
  width the link happens to be, so a short nav link and a long headline each
  get a full-width underline rather than a centred stamp.

  pathLength="1" normalises every variant to the same nominal length, which is
  what lets one stroke-dashoffset transition draw all six at the same speed.
*/}
<svg
  class="scribble"
  viewBox={SCRIBBLE_VIEWBOX}
  preserveAspectRatio="none"
  fill="none"
  aria-hidden="true"
>
  <path d={SCRIBBLE_PATHS[0]} pathLength="1" stroke-width="10" stroke-linecap="round"></path>
</svg>

<style>
  /*
    width is set explicitly because an <svg> is a replaced element: given
    left/right and a height it would size itself from its own 310:40 aspect
    ratio and ignore the box it is sitting in. The script below then narrows
    it to the last line of text.
  */
  .scribble {
    position: absolute;
    left: 0;
    width: 100%;
    top: calc(100% + var(--scribble-drop, 0px));
    height: var(--scribble-height, 0.5em);
    /* Round caps sit slightly proud of the viewBox at this stroke weight. */
    overflow: visible;
    /* The link owns the hover, not the decoration drawn under it. */
    pointer-events: none;
  }

  /*
    The gap is longer than the dash on purpose. `stroke-dasharray: 1` means
    "1 on, 1 off", which repeats — so with the stroke retracted, the pattern's
    next dash begins exactly at the end of the path. That dash has nowhere to
    go and renders as a zero-length segment, which stroke-linecap="round"
    draws as a dot: a stray blue mark under every link that was never hovered.
    A gap of 2 puts the next dash past the end of the path, where it can't be
    drawn at all. The retracted state is then genuinely empty.
  */
  .scribble path {
    stroke: var(--accent);
    stroke-dasharray: 1 2;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 420ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  /*
    The hover lives on the host element, which belongs to whichever component
    used this one — hence :global on that half of the selector.
  */
  :global([data-scribble]:hover) .scribble path,
  :global([data-scribble]:focus-visible) .scribble path {
    stroke-dashoffset: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .scribble path {
      transition: none;
    }
  }
</style>

<script>
  /*
    Cycles the stroke shape so hovering the same link twice doesn't draw the
    identical squiggle. Astro bundles this once per page no matter how many
    scribbles are on it.

    The swap happens after the stroke has retracted, never while it is on
    screen — changing `d` mid-animation would read as a glitch rather than a
    different pen stroke. The :hover guard covers a reader who comes straight
    back before the retract finishes; they just see the same variant again.
  */
  import {SCRIBBLE_PATHS} from '../lib/scribbles'

  const RETRACT_MS = 460

  let next = Math.floor(Math.random() * SCRIBBLE_PATHS.length)

  for (const host of document.querySelectorAll<HTMLElement>('[data-scribble]')) {
    // Specifically the scribble's own path. `querySelector('path')` would take
    // the first path anywhere inside the link, which on a card whose markup
    // contains another drawing — the Reasons notebook tab, say — is the wrong
    // one, and swapping a scribble variant into it replaces that drawing with
    // a squiggle.
    const path = host.querySelector('svg.scribble path')
    if (!path) continue

    const advance = () => {
      if (host.matches(':hover, :focus-visible')) return
      next = (next + 1) % SCRIBBLE_PATHS.length
      path.setAttribute('d', SCRIBBLE_PATHS[next])
    }

    // Stagger the starting shape so two links side by side aren't twins.
    advance()

    host.addEventListener('mouseleave', () => window.setTimeout(advance, RETRACT_MS))
    host.addEventListener('blur', () => window.setTimeout(advance, RETRACT_MS))
  }

  /*
    Narrows each stroke to the last line of the text it underlines.

    CSS alone can only stretch it across the whole box, which is right for a
    one-line nav link but wrong for a headline that wraps — there the box is
    the full column and the last line is usually much shorter, so the stroke
    would run out past the end of the words and read as a mistake. A Range
    over the text reports one rectangle per line; the last one is the line the
    underline belongs under.
  */
  for (const svg of document.querySelectorAll<SVGSVGElement>('svg.scribble')) {
    const holder = svg.parentElement
    if (!holder) continue

    // Only the text, never the svg itself — it is a sibling in this box.
    const text = [...holder.childNodes].filter((node) => node.nodeType === Node.TEXT_NODE)
    if (text.length === 0) continue

    const fit = () => {
      const range = document.createRange()
      range.setStart(text[0], 0)
      range.setEndAfter(text[text.length - 1])
      const lines = [...range.getClientRects()].filter((r) => r.width > 0)
      if (lines.length === 0) return
      const last = lines[lines.length - 1]
      const box = holder.getBoundingClientRect()
      svg.style.width = `${last.width}px`
      svg.style.left = `${last.left - box.left}px`
    }

    // Fires once immediately, and again whenever the line breaks change.
    new ResizeObserver(fit).observe(holder)
  }
</script>
