---
// The masthead. Present on every page, rendered once from BaseLayout.
//
// Two states, and it travels continuously between them rather than snapping:
//
//   At the top of a page with a hero, the wordmark sits large and centred
//   over the photo on a transparent ground, with a hairline running the full
//   width beneath it and the nav links sitting on that line at its right end.
//
//   As you scroll, the wordmark shrinks and slides left, the whole block
//   compresses, and the hairline becomes the bottom edge of a solid bar —
//   small logo left, links right. It is the same rule the whole way; nothing
//   is swapped out or faded in.
//
// The links are right-aligned in BOTH states on purpose. Only the wordmark
// travels, into the space the expanded state leaves empty on the left, which
// is what keeps the movement calm — and it avoids the dead symmetry
// anti-slop.md warns about.
//
// `hasHero` is what tells the masthead it is allowed to start expanded and
// light-on-photo. A page that doesn't pass it (any future page with no hero
// image at the top) gets the compact solid bar from the first paint, which is
// the only correct thing there — a white wordmark on a white page is not.
import Scribble from './Scribble.astro'

interface Props {
  hasHero?: boolean
}

const {hasHero = false} = Astro.props

const links = [
  {label: 'Stories', href: '/stories'},
  {label: 'Journeys', href: '/journeys'},
  {label: 'Resources', href: '/resources'},
  {label: 'About', href: '/about'},
]
---

<nav class:list={['masthead', hasHero && 'masthead--hero']} id="site-masthead">
  <a class="masthead-logo" href="/" aria-label="VIA — Voices in Adventure, home"></a>
  <ul class="masthead-links">
    {
      links.map((link) => (
        <li>
          <a href={link.href} data-scribble>{link.label}<Scribble /></a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  /*
    One number drives the whole transformation: 0 is fully expanded, 1 is
    fully compact. Registering it as a real <number> is what makes the
    calc()s below legal and interpolable.

    initial-value: 1 means the safe state — a solid, legible bar — is what you
    get with no JavaScript, on a page with no hero, and before any script has
    run. Only .masthead--hero opts into starting expanded.
  */
  @property --masthead-t {
    syntax: '<number>';
    inherits: true;
    initial-value: 1;
  }

  .masthead {
    /* The two ends of every journey below. Read each calc() as
       "start at the tall value, travel to the short one as t goes 0 → 1." */
    --logo-w-tall: 150px;
    --logo-h-tall: 69px;
    --logo-w-short: 96px;
    --logo-h-short: 44px;

    --logo-w: calc(var(--logo-w-tall) + (var(--logo-w-short) - var(--logo-w-tall)) * var(--masthead-t));
    --logo-h: calc(var(--logo-h-tall) + (var(--logo-h-short) - var(--logo-h-tall)) * var(--masthead-t));
    --masthead-h: calc(
      var(--masthead-tall) + (var(--masthead-short) - var(--masthead-tall)) * var(--masthead-t)
    );

    /* The hairline over photography. Measured, not guessed — see the scrim
       note below. */
    --rule-over-photo: color-mix(in srgb, var(--bg) 85%, transparent);

    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    height: var(--masthead-h);
    background-color: color-mix(in srgb, var(--bg) calc(var(--masthead-t) * 100%), transparent);
    /* The one rule. Over the hero it is a light hairline on the photo; in the
       compact bar it is that bar's bottom edge. Same element throughout. */
    border-bottom: 1px solid
      color-mix(in srgb, var(--border) calc(var(--masthead-t) * 100%), var(--rule-over-photo));
  }

  /*
    The masthead's own scrim, and the reason index.astro's hero scrim no
    longer carries a top band: the expanded masthead is a band of light type
    over whatever photo the page opens with, reaching further down than the
    hero scrim's top band ever did. Owning the treatment here means it also
    works on article pages, whose hero photos come from the CMS and had no
    scrim at all.

    Sized 1.6× the masthead so it fades out well below the rule — a gradient
    that stopped at the rule would leave a hard seam across the photo, which
    is exactly the tell anti-slop.md warns about.

    The numbers are measured. Compositing this stack against the 95th-
    percentile brightest pixel in each text zone, the worst of the eight house
    photos gives 6.9:1 for the nav links, 7.4:1 for the wordmark, and 5.2:1
    for the rule. Against a pure white photo — the worst thing an editor could
    ever upload — it still gives 4.9:1, 5.6:1 and 3.8:1, so every zone clears
    its gate no matter what goes in the CMS. Re-measure these if the masthead
    heights in tokens.css change.

    It fades out with the collapse because the compact bar is opaque --bg and
    needs no help.
  */
  .masthead::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: calc(var(--masthead-h) * 1.6);
    z-index: -1;
    pointer-events: none;
    opacity: calc(1 - var(--masthead-t));
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--fg) 68%, transparent) 0%,
      color-mix(in srgb, var(--fg) 60%, transparent) 62%,
      transparent 100%
    );
  }

  .masthead--hero {
    --masthead-t: 0;
  }

  /* Asked to hold the compact state, so hold it — from the first paint, and
     the script below never attaches. */
  @media (prefers-reduced-motion: reduce) {
    .masthead--hero {
      --masthead-t: 1;
    }
  }

  /* Nothing to drive the collapse without a script, and an expanded masthead
     that never collapses would sit over the page for the whole scroll. Hold
     the compact bar instead. */
  @media (scripting: none) {
    .masthead--hero {
      --masthead-t: 1;
    }
  }

  /*
    Centred at t=0, flush to the gutter at t=1. The wordmark is the only thing
    that moves horizontally.
  */
  .masthead-logo {
    position: absolute;
    top: calc(var(--space-8) + (var(--space-4) - var(--space-8)) * var(--masthead-t));
    left: calc(
      (100% - var(--logo-w)) / 2 * (1 - var(--masthead-t)) + var(--gutter) * var(--masthead-t)
    );
    width: var(--logo-w);
    height: var(--logo-h);
    /* White over the photo, VIA blue in the solid bar. The logo is a masked
       shape, so its colour is just a background-color — no second asset. */
    background-color: color-mix(in srgb, var(--accent) calc(var(--masthead-t) * 100%), var(--bg));
    -webkit-mask-image: url('/VIALogo.svg');
    mask-image: url('/VIALogo.svg');
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: left center;
    mask-position: left center;
    /* Cancels BaseLayout's fallback hover underline — a masked shape is not
       the place for a rule to try to draw across. */
    background-image: none;
  }

  /*
    Pinned to the bottom of the masthead in both states, so the links simply
    ride up as the block compresses. They sit on the rule at t=0 and are
    optically centred in the bar at t=1.
  */
  .masthead-links {
    position: absolute;
    right: var(--gutter);
    bottom: calc(var(--space-3) + var(--space-4) * var(--masthead-t));
    display: flex;
    align-items: center;
    gap: var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: color-mix(in srgb, var(--fg) calc(var(--masthead-t) * 100%), var(--bg));
  }

  .masthead-links a {
    color: inherit;
    /* The scribble positions itself against this box. */
    position: relative;
    display: inline-block;
    --scribble-height: 0.85em;
    --scribble-drop: -0.15em;
    /* This link's underline is the scribble, not the site-wide fallback. */
    background-image: none;
  }
</style>

<script>
  /*
    Maps scroll position onto the masthead's one variable. The travel distance
    is exactly the height the masthead loses, which means the hairline appears
    to hold still in the document while the block compresses around it.

    Reads both heights back out of CSS rather than repeating them here, so the
    numbers stay in one place.
  */
  const masthead = document.getElementById('site-masthead')
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  if (masthead && masthead.classList.contains('masthead--hero') && !reduceMotion) {
    const styles = getComputedStyle(masthead)
    const tall = parseFloat(styles.getPropertyValue('--masthead-tall'))
    const short = parseFloat(styles.getPropertyValue('--masthead-short'))
    const range = Math.max(tall - short, 1)

    let queued = false

    const update = () => {
      queued = false
      const t = Math.min(Math.max(window.scrollY / range, 0), 1)
      masthead.style.setProperty('--masthead-t', String(t))
    }

    const onScroll = () => {
      if (queued) return
      queued = true
      requestAnimationFrame(update)
    }

    // Covers a reload part-way down the page, where scrollY is already > 0.
    update()
    window.addEventListener('scroll', onScroll, {passive: true})
  }
</script>
