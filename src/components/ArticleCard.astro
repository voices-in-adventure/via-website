---
// The card used everywhere a Dispatch or Signal is teased — Editor's Picks
// today, Stories/Journeys/Resources once they exist. Extracted from the
// homepage so all four places render the same markup instead of drifting
// apart the first time one of them is edited.
import Scribble from './Scribble.astro'
import {urlFor} from '../lib/sanity'
import {articleHref, articleKickerParts, formatDate, type ArticleCard} from '../lib/articles'

interface Props {
  article: ArticleCard
}

const {article} = Astro.props

const kicker = articleKickerParts(article)
---

<article class="card">
  <a class="card-link" href={articleHref(article)} data-scribble>
    {
      article.heroImage && (
        <img
          class="card-media"
          src={urlFor(article.heroImage).width(800).height(600).fit('crop').quality(80).url()}
          alt={article.title}
        />
      )
    }
    <p class="card-kicker">
      <span class="card-kicker-label">{kicker.label}</span>{kicker.city && ` — ${kicker.city}`}
    </p>
    <h3 class="card-title">
      <span class="card-title-text">{article.title}<Scribble /></span>
    </h3>
    <p class="card-dek">{article.dek}</p>
    <p class="card-byline">
      {article.author?.name}
      {article.author?.name ? ' · ' : ''}
      {formatDate(article.publishedAt)}
    </p>
  </a>
</article>

<style>
  .card-link {
    display: flex;
    flex-direction: column;
    /* No lift, no scale, no glow — anti-slop.md calls the hover-lift card a
       stock component. The title's underline is the whole hover. */
    background-image: none;
  }

  .card-media {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    margin-bottom: var(--space-4);
  }

  /*
    Only the word that says what the piece is takes the accent. The city and
    the dash stay muted — colouring the whole string turned the accent into a
    label background rather than a signal.
  */
  .card-kicker {
    margin: 0 0 var(--space-2);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--muted);
  }

  .card-kicker-label {
    color: var(--accent);
  }

  /*
    The whole card is the link, but the underline draws under the title only —
    a rule running the width of a photograph would look like a mistake.
  */
  .card-title {
    margin: 0 0 var(--space-3);
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: 1.3;
    color: var(--fg);
  }

  /*
    The scribble is drawn under this span, so it needs to be a block the
    stroke can measure itself against. inline-block means a one-line headline
    gets a stroke the width of its text; a headline that wraps gets one the
    width of the title column, drawn under the last line.
  */
  .card-title-text {
    position: relative;
    display: inline-block;
    --scribble-height: 0.7em;
    --scribble-drop: -0.28em;
  }

  .card-dek {
    margin: 0 0 var(--space-3);
    font-family: var(--font-serif);
    font-size: var(--text-base);
    line-height: 1.5;
    color: var(--muted);
  }

  .card-byline {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--muted);
  }
</style>
