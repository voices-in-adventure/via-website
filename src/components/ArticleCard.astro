---
// The card used everywhere a Dispatch or Signal is teased — Editor's Picks
// today, Stories/Journeys/Resources once they exist. Extracted from the
// homepage so all four places render the same markup instead of drifting
// apart the first time one of them is edited.
import {urlFor} from '../lib/sanity'
import {articleHref, articleKicker, formatDate, type ArticleCard} from '../lib/articles'

interface Props {
  article: ArticleCard
}

const {article} = Astro.props
---

<article class="card">
  <a class="card-link" href={articleHref(article)}>
    {
      article.heroImage && (
        <img
          class="card-media"
          src={urlFor(article.heroImage).width(800).height(600).fit('crop').quality(80).url()}
          alt={article.title}
        />
      )
    }
    <p class="card-kicker">{articleKicker(article)}</p>
    <h3 class="card-title">
      <span class="card-title-text">{article.title}</span>
    </h3>
    <p class="card-dek">{article.dek}</p>
    <p class="card-byline">
      {article.author?.name}
      {article.author?.name ? ' · ' : ''}
      {formatDate(article.publishedAt)}
    </p>
  </a>
</article>

<style>
  .card-link {
    display: flex;
    flex-direction: column;
    /* No lift, no scale, no glow — anti-slop.md calls the hover-lift card a
       stock component. The title's underline is the whole hover. */
    background-image: none;
  }

  .card-media {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    margin-bottom: var(--space-4);
  }

  /* One of the site's two sanctioned accent uses — see anti-slop.md's
     two-per-screen budget. The other is the hover-underline system below. */
  .card-kicker {
    margin: 0 0 var(--space-2);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--accent);
  }

  /*
    The whole card is the link, but the underline draws under the title only —
    a rule running the width of a photograph would look like a mistake.
  */
  .card-title {
    margin: 0 0 var(--space-3);
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: 1.3;
    color: var(--fg);
  }

  /*
    The rule lives on an inner inline span, not on the heading itself. A
    background on a wrapped inline box is painted once across the whole box,
    which puts a single full-width rule under the last line; box-decoration-break
    gives each line its own, so the underline follows a two-line headline
    the way it follows a one-line one.
  */
  .card-title-text {
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    background-image: linear-gradient(var(--accent), var(--accent));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1px;
    transition: background-size 260ms ease;
  }

  .card-link:hover .card-title-text,
  .card-link:focus-visible .card-title-text {
    background-size: 100% 1px;
  }

  @media (prefers-reduced-motion: reduce) {
    .card-title-text {
      transition: none;
    }
  }

  .card-dek {
    margin: 0 0 var(--space-3);
    font-family: var(--font-serif);
    font-size: var(--text-base);
    line-height: 1.5;
    color: var(--muted);
  }

  .card-byline {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--muted);
  }
</style>
