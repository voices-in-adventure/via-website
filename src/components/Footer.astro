---
// Present on every page (rendered once from BaseLayout). Fetches its own
// siteSettings rather than taking them as a prop, so every current and
// future page gets a working footer without having to remember to wire one
// through — see docs/content-model.md, "siteSettings."
//
// Every column is built in the frontmatter and rendered by one loop below.
// That is partly tidiness and partly so the hover scribble is attached in a
// single place instead of six.
import Scribble from './Scribble.astro'
import {sanityClient} from '../lib/sanity'

interface SocialLink {
  platform: string
  url: string
}

interface FooterSettings {
  dispatchSubscribeUrl?: string | null
  signalsSubscribeUrl?: string | null
  pitchUsUrl?: string | null
  feedbackUrl?: string | null
  socialLinks?: SocialLink[] | null
}

const settings = await sanityClient.fetch<FooterSettings | null>(
  `*[_type == "siteSettings"][0]{
    dispatchSubscribeUrl, signalsSubscribeUrl, pitchUsUrl, feedbackUrl, socialLinks
  }`,
)

interface FooterLink {
  label: string
  href: string
  external?: boolean
}

interface FooterColumn {
  heading: string
  /** Set when the column is genuinely navigation and wants a landmark. */
  landmark?: string
  links: FooterLink[]
}

const platformLabels: Record<string, string> = {
  instagram: 'Instagram',
  tiktok: 'TikTok',
  twitter: 'X / Twitter',
  linkedin: 'LinkedIn',
  other: 'Other',
}

/** Drops anything whose URL isn't set in Sanity yet, rather than inventing one. */
const present = (links: (FooterLink | null)[]): FooterLink[] =>
  links.filter((link): link is FooterLink => link !== null)

const columns: FooterColumn[] = [
  {
    heading: 'Explore',
    landmark: 'Site',
    links: [
      {label: 'Stories', href: '/stories'},
      {label: 'Journeys', href: '/journeys'},
      {label: 'Resources', href: '/resources'},
      {label: 'About', href: '/about'},
    ],
  },
  {
    heading: 'Subscribe',
    links: present([
      settings?.dispatchSubscribeUrl
        ? {label: 'Dispatches', href: settings.dispatchSubscribeUrl}
        : null,
      settings?.signalsSubscribeUrl ? {label: 'Signals', href: settings.signalsSubscribeUrl} : null,
    ]),
  },
  {
    heading: 'Connect',
    links: (settings?.socialLinks ?? []).map((link) => ({
      label: platformLabels[link.platform] ?? link.platform,
      href: link.url,
      external: true,
    })),
  },
  {
    heading: 'Contribute',
    links: present([
      settings?.pitchUsUrl ? {label: 'Pitch us', href: settings.pitchUsUrl} : null,
      settings?.feedbackUrl ? {label: 'Give feedback', href: settings.feedbackUrl} : null,
    ]),
  },
].filter((column) => column.links.length > 0)
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a class="footer-logo" href="/" aria-label="VIA — Voices in Adventure, home"></a>
    </div>

    {
      columns.map((column) => {
        const Wrapper = column.landmark ? 'nav' : 'div'
        return (
          <Wrapper class="footer-col" aria-label={column.landmark}>
            <p class="footer-heading">{column.heading}</p>
            <ul class="footer-list">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    data-scribble
                    target={link.external ? '_blank' : undefined}
                    rel={link.external ? 'noopener noreferrer' : undefined}
                  >{link.label}<Scribble /></a>
                </li>
              ))}
            </ul>
          </Wrapper>
        )
      })
    }
  </div>
</footer>

<style>
  .footer {
    /* Same stacking treatment as index.astro's .scroller: the homepage hero
       stays position: sticky for longer than the scroller's own content
       runs, so anything after it in the DOM needs its own stacking context
       and opaque background or the still-stuck hero paints through it. */
    position: relative;
    z-index: 1;
    background: var(--surface);
    border-top: 1px solid var(--border);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-16);
    padding: var(--space-16) var(--gutter);
  }

  .footer-brand {
    flex: 1 1 200px;
  }

  .footer-logo {
    display: block;
    width: 88px;
    height: 40px;
    background-color: var(--fg);
    -webkit-mask-image: url('/VIALogo.svg');
    mask-image: url('/VIALogo.svg');
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: left center;
    mask-position: left center;
    background-image: none;
  }

  .footer-col {
    min-width: 140px;
  }

  .footer-heading {
    margin: 0 0 var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    text-transform: uppercase;
    color: var(--muted);
  }

  .footer-list {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    /* Roomier than a plain list needs: the hover scribble hangs below each
       link and would otherwise cross into the one underneath. */
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
  }

  .footer-list a {
    color: var(--fg);
    /* The scribble measures itself against this box. */
    position: relative;
    display: inline-block;
    --scribble-height: 0.85em;
    --scribble-drop: -0.15em;
    /* These links use the scribble, not the site-wide fallback underline. */
    background-image: none;
  }
</style>
