---
// The document shell every page wraps in. Loads the three brand
// typefaces and the design tokens, then applies the base tokens
// (background, text color, body type) to <body>. No page or component
// design lives here on purpose — see docs/via-design.md for that.
import '@fontsource-variable/newsreader/standard.css'
import '@fontsource-variable/newsreader/standard-italic.css'
import '@fontsource/poppins/400.css'
import '@fontsource/poppins/500.css'
import '@fontsource/poppins/600.css'
import '@fontsource/space-mono/400.css'
import '../styles/tokens.css'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'

interface Props {
  title: string
  description?: string
  /**
   * Does this page open with full-bleed hero art? The masthead needs to know
   * before it paints: over a photo it starts expanded and light, and on a
   * page without one it has to start as the compact solid bar instead.
   */
  hasHero?: boolean
}

const {title, description, hasHero = false} = Astro.props
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <Nav hasHero={hasHero} />
    <slot />
    <Footer />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
  }

  body {
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-serif);
    font-size: var(--text-base);
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  img {
    max-width: 100%;
    display: block;
  }

  /*
    Link text stays whatever color it sits in — only the hover underline is
    colored, and it's one of the site's two sanctioned accent uses (the other
    is the "Dispatch"/"Signal" kicker labels). Every link on the site shares
    this one underline system, so it counts as a single use per anti-slop.md's
    two-per-screen budget rather than one per link.

    BodyLink.astro (links inside article prose) intentionally does NOT use
    this rule — it has its own always-on --fg underline, because a single
    article can carry a dozen inline links and coloring all of them accent
    would blow the budget by itself. See the comment there.

    The rule is a background gradient rather than text-decoration because only
    background-size is animatable; the underline grows from the left on hover
    instead of appearing all at once. No library, no JavaScript.
  */
  a {
    color: inherit;
    text-decoration: none;
    background-image: linear-gradient(var(--accent), var(--accent));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1px;
    transition: background-size 260ms ease;
  }

  a:hover,
  a:focus-visible {
    background-size: 100% 1px;
  }

  @media (prefers-reduced-motion: reduce) {
    a {
      transition: none;
    }
  }
</style>
