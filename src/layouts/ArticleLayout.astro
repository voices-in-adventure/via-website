---
// The article template. Dispatch and Signal share it and differ only in
// metadata density — content-model.md says so explicitly, and two nearly
// identical templates would drift apart the first time either is edited.
//
// Register is GJIA per docs/via-design.md: generous measure, real hierarchy,
// photography integrated rather than decorative.
import BaseLayout from './BaseLayout.astro'
import PortableBody from '../components/PortableBody.astro'
import TagLink from '../components/TagLink.astro'
import {urlFor} from '../lib/sanity'
import {articleKickerParts, formatDate, placeHref, reasonHref, type Article} from '../lib/articles'

interface Props {
  article: Article
}

const {article} = Astro.props

const heroUrl = urlFor(article.heroImage).width(2400).quality(80).url()

const isSignal = article._type === 'signal'

// "Destination Guide · 36 hours" — only Dispatches carry a format.
const formatLabels: Record<string, string> = {
  guide: 'Destination Guide',
  feature: 'Feature',
  essay: 'Essay',
}
const formatLabel = article.format ? formatLabels[article.format] : null

/*
  "Filed under" is the way into the Journeys archives. Places come first and
  carry their region color; reasons follow, uncolored. A tag whose slug or
  title never got filled in is dropped rather than printed as a dead
  rectangle — neither field is required() on the tag types.
*/
const tags = [
  ...(article.places ?? []).map((tag) => ({
    ...tag,
    href: tag.slug ? placeHref(tag.slug) : null,
  })),
  ...(article.reasons ?? []).map((tag) => ({
    ...tag,
    color: null,
    href: tag.slug ? reasonHref(tag.slug) : null,
  })),
].filter((tag) => tag.title && tag.href)

const kicker = articleKickerParts(article)

const asOfFormatter = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
})
---

<BaseLayout title={`${article.title} — VIA`} description={article.dek} hasHero>
  <article class="article">
    <figure class="article-hero">
      {/*
        Decorative: the headline sitting on this photo is real text below, and
        the caption underneath carries whatever description the editors wrote.
        Repeating the title in alt would make a screen reader read it twice.
      */}
      <div class="article-hero-media">
        <img src={heroUrl} alt="" />
        <div class="article-hero-scrim" aria-hidden="true"></div>

        <div class="article-hero-text">
          <p class="kicker kicker--over">
            <span class="kicker-label">{kicker.label}</span>{kicker.city && ` from ${kicker.city}`}
            {formatLabel && <span class="kicker-sep">·</span>}
            {formatLabel}
            {article.duration && <span class="kicker-sep">·</span>}
            {article.duration && `${article.duration} hours`}
          </p>
          <h1 class="title">{article.title}</h1>
        </div>
      </div>

      {
        article.heroCaption && (
          <figcaption>
            <span>{article.heroCaption}</span>
          </figcaption>
        )
      }
    </figure>

    <header class="article-head">
      <p class="dek">{article.dek}</p>

      <p class="byline">
        {article.author?.name && <span class="byline-name">By {article.author.name}</span>}
        {article.author?.role && <span class="byline-role">{article.author.role}</span>}
        <span class="byline-date">{formatDate(article.publishedAt)}</span>
      </p>
    </header>

    {
      /*
        Signals are reported news, so they lead with the development they are
        grounded in and the date that information was accurate. content-model.md
        requires both, and a reader deciding whether to trust a visa rule needs
        them before the body, not after.
      */
      isSignal && article.newsPeg && (
        <aside class="news-peg">
          <p class="news-peg-label">What happened</p>
          <p class="news-peg-text">{article.newsPeg}</p>
          {article.informationAsOf && (
            <p class="news-peg-asof">
              Information accurate as of {asOfFormatter.format(new Date(article.informationAsOf))}
            </p>
          )}
        </aside>
      )
    }

    <div class="article-body">
      <PortableBody value={article.body} />
    </div>

    {
      tags.length > 0 && (
        <footer class="article-foot">
          <p class="tags-label">Filed under</p>
          <ul class="tags">
            {tags.map((tag) => (
              <li>
                <TagLink href={tag.href!} label={tag.title!} color={tag.color} />
              </li>
            ))}
          </ul>
        </footer>
      )
    }
  </article>
</BaseLayout>

<style>
  .article {
    padding-bottom: var(--space-32);
  }

  /* Full-bleed, no radius — via-design.md: "Full-bleed media has no radius." */
  .article-hero {
    margin: 0 0 var(--space-12);
  }

  /*
    The photo, its scrim, and the headline are one box; the caption sits
    outside it. Without this wrapper the scrim's inset: 0 reached the bottom
    of the whole figure and laid a grey band over the caption.
  */
  .article-hero-media {
    position: relative;
  }

  /*
    Taller than it was, because it now carries the headline as well as the
    photograph. The floor keeps a short window from crushing the title into
    the masthead above it.
  */
  .article-hero img {
    display: block;
    width: 100%;
    height: 78vh;
    min-height: 560px;
    object-fit: cover;
  }

  /*
    The scrim the headline sits on. It runs left to right rather than bottom
    to top because the type is left-aligned and vertically centred — a bottom
    gradient would darken the half of the photo the words are not on.

    The stops are measured, not eyeballed. anti-slop.md requires text over
    photography to hold up against the *worst* image the CMS will accept, so
    they are set against a pure white photo, which is the worst case there is:

      across the hero   combined ink   contrast for --bg type
      0%                       0.78            9.0:1
      22%                      0.75            8.0:1
      42%                      0.58            4.4:1

    The headline column below is capped at 620px, which is about 43% of a
    1440px window — so the type never leaves the zone those figures cover.
    The 42% figure clears the 3:1 gate for large text with room to spare and
    very nearly clears the 4.5:1 body gate too.

    If the headline column is ever widened, re-run those numbers. Past 60%
    across, this scrim does not hold small type on a bright photo.
  */
  .article-hero-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(
        to right,
        color-mix(in srgb, var(--fg) 70%, transparent) 0%,
        color-mix(in srgb, var(--fg) 66%, transparent) 22%,
        color-mix(in srgb, var(--fg) 56%, transparent) 42%,
        color-mix(in srgb, var(--fg) 28%, transparent) 62%,
        color-mix(in srgb, var(--fg) 8%, transparent) 80%,
        transparent 100%
      ),
      linear-gradient(
        to top,
        color-mix(in srgb, var(--fg) 26%, transparent) 0%,
        color-mix(in srgb, var(--fg) 8%, transparent) 35%,
        transparent 60%
      );
  }

  /*
    Left-aligned and vertically centred, as asked. It sits in the same 1400px
    container as the rest of the site so the headline starts on the same left
    edge as the body copy below it, rather than floating at its own margin.
  */
  .article-hero-text {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 1400px;
    margin: 0 auto;
    padding: var(--masthead-tall) var(--gutter) 0;
  }

  .article-hero-text .kicker,
  .article-hero-text .title {
    max-width: 620px;
  }

  /*
    The caption's column has to be measured in the same font as the article's,
    or it will not line up with the title below it. --measure is 68ch, and ch
    is the width of a "0" in whatever font the element itself is set in — so
    a figcaption carrying the small sans face computes a visibly narrower
    column than the serif article column, and centring that narrower column
    pushes the caption inboard of the headline.

    The width therefore stays on the figcaption, which inherits the body
    serif, and the caption's own type sits on the span inside it.
  */
  .article-hero figcaption {
    max-width: var(--measure);
    margin: var(--space-3) auto 0;
    padding: 0 var(--gutter);
  }

  .article-hero figcaption span {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--muted);
  }

  .article-head,
  .article-body,
  .article-foot {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .article-head {
    margin-bottom: var(--space-16);
  }

  /*
    Only "Dispatch"/"Signal" takes the accent. The city, the separators, the
    format, and the duration all stay muted — the accent marks what the piece
    is, not the whole metadata line.
  */
  .kicker {
    margin: 0 0 var(--space-4);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--muted);
  }

  .kicker-label {
    color: var(--accent);
  }

  /*
    Over the photo the whole kicker goes light, accent word included. VIA blue
    is a mid-tone: it passes 4.5:1 on --bg, which is what it was picked for,
    and fails badly on a dark scrim. The accent is spent elsewhere on this
    page instead.
  */
  .kicker--over,
  .kicker--over .kicker-label {
    color: var(--bg);
  }

  .kicker--over {
    margin-bottom: var(--space-6);
  }

  .kicker-sep {
    margin: 0 var(--space-2);
  }

  /*
    Display type gets air — via-design.md: "cramped display type reads as
    amateur faster than almost anything else."
  */
  .title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.01em;
    color: var(--bg);
  }

  .dek {
    margin: 0 0 var(--space-8);
    max-width: var(--measure);
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-style: italic;
    line-height: 1.45;
    color: var(--muted);
  }

  .byline {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
    margin: 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--muted);
  }

  .byline-name {
    color: var(--fg);
    font-weight: 500;
  }

  .news-peg {
    max-width: var(--measure);
    margin: 0 auto var(--space-16);
    padding: var(--space-6) var(--gutter);
    background: var(--surface);
    border-left: 2px solid var(--fg);
  }

  .news-peg-label {
    margin: 0 0 var(--space-2);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--muted);
  }

  .news-peg-text {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-base);
    line-height: 1.55;
    color: var(--fg);
  }

  .news-peg-asof {
    margin: var(--space-4) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted);
  }

  .article-foot {
    margin-top: var(--space-16);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }

  .tags-label {
    margin: 0 0 var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .article-hero img {
      height: 68vh;
      min-height: 460px;
    }

    .title {
      font-size: var(--text-xl);
      line-height: 1.15;
    }

    /*
      The scrim goes to a bottom-up gradient on narrow screens. There is no
      "left half" of a 390px photo to speak of, so a sideways gradient would
      just darken the whole image unevenly; anchoring the type to the bottom
      and darkening upward is the treatment that fits the shape.
    */
    .article-hero-text {
      justify-content: flex-end;
      padding-bottom: var(--space-12);
    }

    .article-hero-scrim {
      background: linear-gradient(
        to top,
        color-mix(in srgb, var(--fg) 76%, transparent) 0%,
        color-mix(in srgb, var(--fg) 64%, transparent) 30%,
        color-mix(in srgb, var(--fg) 34%, transparent) 55%,
        color-mix(in srgb, var(--fg) 10%, transparent) 78%,
        transparent 100%
      );
    }
  }

  /* The rectangle itself lives in components/TagLink.astro — it is shared
     with the Journeys archives, which put the same tags at their foot. */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
