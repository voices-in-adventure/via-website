---
// One page per published Dispatch. All the layout lives in ArticleLayout —
// this file only decides which documents get a page and fetches them.
import ArticleLayout from '../../layouts/ArticleLayout.astro'
import {sanityClient} from '../../lib/sanity'
import {ARTICLE_PROJECTION, type Article} from '../../lib/articles'

export async function getStaticPaths() {
  const dispatches = await sanityClient.fetch<Article[]>(
    // Destination Guides are excluded: they have their own route and template
    // under /journeys/guides/. Without this they would build at both
    // addresses, which is two URLs for one piece.
    `*[_type == "dispatch" && format != "guide" && defined(slug.current) && publishedAt <= now()]{${ARTICLE_PROJECTION}}`,
  )

  return dispatches.map((article) => ({
    params: {slug: article.slug},
    props: {article},
  }))
}

const {article} = Astro.props as {article: Article}
---

<ArticleLayout article={article} />
