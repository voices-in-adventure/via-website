---
// TEMPORARY — confirms Sanity data (including resolved references and the
// hero image asset) reaches the Astro build. No styling on purpose. Delete
// this page once that's confirmed.
import {sanityClient, urlFor} from '../lib/sanity'

const DISPATCH_QUERY = `*[_type == "dispatch" && slug.current == $slug][0]{
  title,
  dek,
  heroImage,
  heroCaption,
  body,
  publishedAt,
  format,
  duration,
  city,
  featured,
  "author": author->{name, role},
  "places": places[]->{title, "slug": slug.current},
  "reasons": reasons[]->{title, "slug": slug.current},
  "products": products[]->{name, "slug": slug.current, category}
}`

const dispatch = await sanityClient.fetch(DISPATCH_QUERY, {
  slug: '36-hours-in-lisbon-on-a-study-abroad-budget',
})

// Body is Portable Text (an array of blocks). This is a bare-bones
// block-to-text renderer just to prove the content is there — the real
// article template will use a proper Portable Text renderer.
function renderBlock(block: any) {
  if (block._type === 'image') {
    return `[image block: ${block.asset?._ref ?? 'no asset ref'}]`
  }
  const text = (block.children ?? []).map((child: any) => child.text).join('')
  return block.style === 'h2' ? `## ${text}` : text
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Sanity data test</title>
  </head>
  <body>
    <h1>Sanity data test</h1>

    {!dispatch && <p>No dispatch found for that slug.</p>}

    {dispatch && (
      <div>
        <h2>{dispatch.title}</h2>
        <p><em>{dispatch.dek}</em></p>

        <p>
          By {dispatch.author?.name} ({dispatch.author?.role}) —
          published {dispatch.publishedAt} — format: {dispatch.format},
          {dispatch.duration && ` ${dispatch.duration}h,`}
          {dispatch.city && ` city: ${dispatch.city},`}
          featured: {String(dispatch.featured)}
        </p>

        {dispatch.heroImage && (
          <div>
            <img src={urlFor(dispatch.heroImage).width(1200).url()} alt="" width="600" />
            {dispatch.heroCaption && <p>{dispatch.heroCaption}</p>}
          </div>
        )}

        <h3>Body</h3>
        {dispatch.body?.map((block: any) => <p>{renderBlock(block)}</p>)}

        <h3>Places</h3>
        <ul>
          {dispatch.places?.map((place: any) => <li>{place.title} ({place.slug})</li>)}
        </ul>

        <h3>Reasons</h3>
        <ul>
          {dispatch.reasons?.map((reason: any) => <li>{reason.title} ({reason.slug})</li>)}
        </ul>

        <h3>Products</h3>
        <ul>
          {dispatch.products?.map((product: any) => (
            <li>{product.name} ({product.category}) — {product.slug}</li>
          ))}
        </ul>

        <h3>Raw JSON</h3>
        <pre>{JSON.stringify(dispatch, null, 2)}</pre>
      </div>
    )}
  </body>
</html>
