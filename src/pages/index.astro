---
import BaseLayout from '../layouts/BaseLayout.astro'
import WorldClockTicker from '../components/WorldClockTicker.astro'
import ArticleCard from '../components/ArticleCard.astro'
import SectionHead from '../components/SectionHead.astro'
import Topography from '../components/Topography.astro'
import PhotoMontage from '../components/PhotoMontage.astro'
import {sanityClient, urlFor} from '../lib/sanity'
import {getTimezoneForCity} from '../lib/cityTimezones'
import {
  FEATURED_ARTICLES,
  LATEST_ARTICLES,
  type ArticleCard as ArticleCardType,
} from '../lib/articles'
import type {SanityImageSource} from '@sanity/image-url'

interface SiteSettings {
  heroType: 'image' | 'video'
  heroImage?: SanityImageSource
  heroVideoUrl?: string
  missionStatement?: string
  heroLines?: string[]
  homeIntro?: string[]
}

const siteSettings = await sanityClient.fetch<SiteSettings | null>(
  `*[_type == "siteSettings"][0]{
    heroType, heroImage, heroVideoUrl, missionStatement, heroLines, homeIntro
  }`,
)

/*
  The hero copy, in the order the editors set it. The first line is the
  tagline — short, and set apart — and everything after it reads as one
  paragraph of mission beneath.

  Nothing here fades or staggers in. The client's copy is headed "appear in
  order", and order down the page is what that gets: anti-slop.md rules out
  hiding content behind an entrance animation, and the first thing a reader
  sees on the site is the last place to make words wait for a script.
*/
const homeIntro = (siteSettings?.homeIntro ?? []).map((line) => line.trim()).filter(Boolean)

const heroLines = (siteSettings?.heroLines ?? []).map((line) => line.trim()).filter(Boolean)
const [heroTagline, ...heroMission] =
  heroLines.length > 0
    ? heroLines
    : siteSettings?.missionStatement
      ? [null, siteSettings.missionStatement]
      : []

/*
  The front page is built out of two ordered lists and nothing else.

  The editors' picks fill the front block, most recent first: the newest one
  is the lead, the next two flank it, the four after that become the rail of
  headlines. That is the whole ranking — there is no second place in Sanity
  for an editor to say which story is the big one. Publishing order decides
  it, which is how a newspaper works and one fewer field to keep in sync.

  Everything published then fills the river below, minus whatever the front
  block already used. That way the bottom of the page keeps showing recent
  work even in a week when nothing new was featured.
*/
const featured = await sanityClient.fetch<ArticleCardType[]>(FEATURED_ARTICLES)
const latest = await sanityClient.fetch<ArticleCardType[]>(LATEST_ARTICLES)

const lead = featured[0] ?? latest[0] ?? null
const flank = featured.slice(1, 3)
const rail = featured.slice(3, 7)

const shown = new Set([lead, ...flank, ...rail].filter(Boolean).map((a) => a!.slug))
const river = latest.filter((a) => !shown.has(a.slug)).slice(0, 10)

// Homepage ticker: the cities of the most recent published Dispatches —
// never a hardcoded list. See docs/content-model.md, "Homepage ticker."
//
// Three. It briefly ran to six, which is what the client's edit round asked
// for, and was reverted with the rest of the front page at the owner's
// direction. Three items spread across the hero's bottom edge land left,
// centre and right; six read as a crowded row of clocks. Fetching more than
// three and slicing after leaves room for repeated cities to collapse
// without coming up short.
const TICKER_CITY_COUNT = 3

const dispatchCities = await sanityClient.fetch<string[]>(
  `*[_type == "dispatch" && publishedAt <= now() && defined(city) && city != ""]
    | order(publishedAt desc)[0...24].city`,
)
// Cities without a known timezone are dropped *before* counting, so an
// unrecognised city never takes a slot or shows up without a clock. Repeats
// are collapsed ignoring case/spacing, so "Paris" and "paris " count once.
const seenTimezoneKeys = new Set<string>()
const tickerCities = dispatchCities
  .filter((city) => {
    if (!getTimezoneForCity(city)) return false
    const key = city.trim().toLowerCase()
    if (seenTimezoneKeys.has(key)) return false
    seenTimezoneKeys.add(key)
    return true
  })
  .slice(0, TICKER_CITY_COUNT)

/*
  The hero photo, in order of preference:

  1. Whatever an editor set in Sanity. If the field has an image, that image
     is the hero and there is no crossfade — the CMS stays in charge.
  2. Otherwise, the house photo set, crossfading slowly through all eight for
     as long as the tab stays open (see the inline script below).

  Clearing the field in Sanity Studio restores the crossfade.

  object-position is set per photo because none of the eight crop cleanly to
  a wide hero out of the box; centering them by default cuts the subject.
*/
const sanityHeroUrl =
  siteSettings?.heroType === 'image' && siteSettings.heroImage
    ? urlFor(siteSettings.heroImage).width(2400).quality(80).url()
    : null

const HOUSE_HEROES = [
  {src: '/imagery/HeroImage2.jpg', position: 'center 50%'},
  {src: '/imagery/HeroImage3.jpg', position: 'center 55%'},
  {src: '/imagery/HeroImage4.jpg', position: 'center 50%'},
  {src: '/imagery/HeroImage5.jpg', position: 'center 40%'},
  {src: '/imagery/HeroImage6.jpg', position: 'center center'},
  {src: '/imagery/HeroImage7.jpg', position: 'center 42%'},
  {src: '/imagery/HeroImage8.jpg', position: 'center 46%'},
  {src: '/imagery/HeroImage9.jpg', position: 'center 40%'},
]
---

<BaseLayout title="VIA — Voices in Adventure" description={siteSettings?.missionStatement} hasHero>
  <section class="hero">
    <div class="hero-frame">
      {
        sanityHeroUrl ? (
          <img class="hero-media" src={sanityHeroUrl} alt="" />
        ) : (
          <PhotoMontage photos={HOUSE_HEROES} />
        )
      }
      <div class="hero-scrim" aria-hidden="true"></div>
    </div>

    <div class="hero-content">
      {heroTagline && <p class="hero-tagline">{heroTagline}</p>}
      {
        heroMission.length > 0 && (
          <div class="hero-mission">
            {heroMission.map((line) => (
              <p>{line}</p>
            ))}
          </div>
        )
      }
    </div>

    {tickerCities.length > 0 && <WorldClockTicker cities={tickerCities} />}
  </section>

  {/*
    Everything below the hero scrolls up over it. It needs its own stacking
    context and an opaque background for that to read as one surface passing
    in front of another rather than as a rendering bug.
  */}
  <div class="scroller">
    {
      homeIntro.length > 0 && (
        <section class="intro">
          <Topography tone="blue" />
          <div class="intro-inner">
            {homeIntro.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </section>
      )
    }

    {
      lead && (
        <section class="front-section">
          <div class="section-inner">
            <SectionHead title="Editor's Picks" />
            <div
              class:list={[
                'front',
                flank.length === 0 && 'front--no-flank',
                rail.length === 0 && 'front--no-rail',
              ]}
            >
              {flank.length > 0 && (
                <div class="front-flank">
                  {flank.map((article) => (
                    <ArticleCard article={article} kickerAccent={false} />
                  ))}
                </div>
              )}

              <div class="front-lead">
                <ArticleCard article={lead} variant="lead" />
              </div>

              {rail.length > 0 && (
                <div class="front-rail">
                  {rail.map((article) => (
                    <ArticleCard article={article} variant="compact" kickerAccent={false} />
                  ))}
                </div>
              )}
            </div>
          </div>
        </section>
      )
    }

    {
      river.length > 0 && (
        <section class="river-section">
          <div class="section-inner">
            <SectionHead title="Latest" actionLabel="All stories" actionHref="/stories" />
            <div class="river-grid">
              {river.map((article, i) => (
                <ArticleCard
                  article={article}
                  variant={i < 2 ? 'wide' : 'compact'}
                  kickerAccent={false}
                />
              ))}
            </div>
          </div>
        </section>
      )
    }

    <section class="social">
      <div class="social-inner">
        <p class="social-eyebrow">Social feed</p>
        <p class="social-message">
          Coming soon — VIA&rsquo;s Instagram isn&rsquo;t live yet. When it is, recent posts will run here.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /*
    The hero holds still while the content scrolls over it. position: sticky
    does the whole job — no scroll listener, no GSAP, no Lenis. It stays stuck
    for as long as its parent (the page body) is still scrolling past.
  */
  .hero {
    position: sticky;
    top: 0;
    z-index: 0;
    height: 100vh;
    min-height: 640px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    /*
      Reserves the expanded masthead's full height. The masthead is fixed, so
      it can't push anything down on its own; without this, a short enough
      window would let the mission statement run up underneath the wordmark.
      Nothing collides at normal desktop heights today — this makes it
      impossible at any height.
    */
    padding-top: var(--masthead-tall);
  }

  /*
    The drift lives here rather than on the photo itself — PhotoMontage renders
    two crossfading layers, so one shared animation on their parent is simpler
    than duplicating it per layer, and it applies equally to the single-image
    Sanity-override case below.
  */
  .hero-frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
    transform: scale(1.06);
    transform-origin: center;
    will-change: transform;
  }

  .hero-media {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /*
    A slow drift tied to scroll position, not to a timer. A looping time-based
    animation would be the "floating decorative element" anti-slop.md rules
    out; this only moves because the reader moved.

    Browsers without scroll-driven animation, and readers who have asked for
    reduced motion, get a still photo and lose nothing.
  */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero-frame {
        /* Longhands, not the `animation` shorthand: Lightning CSS folds a
           neighbouring animation-timeline into the shorthand and produces an
           invalid declaration the browser then drops. See HandRule.astro. */
        animation-name: hero-drift;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root block);
        animation-range: 0 100vh;
      }
    }
  }

  @keyframes hero-drift {
    from {
      transform: scale(1.06) translateY(0);
    }
    to {
      transform: scale(1.12) translateY(-3%);
    }
  }

  /*
    Two layers: a bottom gradient carrying the mission and ticker type, and a
    flat wash over the whole photo that just settles it down. Every value
    derives from --fg via color-mix, so no new color enters the codebase and a
    palette change still propagates from tokens.css.

    The bottom gradient's stops are measured — sampled the 95th-percentile
    brightest pixel in each text zone, across all eight house photos, run
    through the actual gradient math to get real post-scrim WCAG contrast
    against --bg. The flat wash is not; it has since been thinned by eye at
    the owner's direction, which lifts both zones somewhat off the numbers
    below.

    There used to be a third gradient here darkening the top of the hero for
    the nav. It has moved into Nav.astro, because the masthead now needs a
    much taller treatment than this one reached and needs it on article pages
    too — see the note there. What is left covers the two zones that belong to
    the hero itself.

    Worst case per zone when last measured, with the wash at 18%:
      mid (mission)    Hero5  ~6.7:1
      bottom (ticker)  Hero5  ~12.6:1

    The wash carries little of that — the bottom gradient does the work in
    both zones — so thinning it costs these figures only a fraction of a
    point. That is why it was the place to take weight out of the hero.
  */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to top,
        color-mix(in srgb, var(--fg) 82%, transparent) 0%,
        color-mix(in srgb, var(--fg) 55%, transparent) 25%,
        transparent 55%
      ),
      color-mix(in srgb, var(--fg) 11%, transparent);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    padding: 0 var(--gutter);
  }

  /*
    The tagline reads as a definition, so it is set apart from the mission
    under it: the utility face, small, and in the same near-white as
    everything else over the photo. It is the one line on the hero that is
    not a sentence, and it should not pretend to be one.
  */
  .hero-tagline {
    margin: 0 0 var(--space-4);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
    color: var(--bg);
  }

  /*
    The mission sits in the lower third with a full --space-24 between it and
    the ticker, so the two never read as one crowded block.
  */
  .hero-mission {
    max-width: 52ch;
    margin: 0 0 var(--space-24);
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: 1.45;
    color: var(--bg);
  }

  .hero-mission :global(p) {
    margin: 0;
  }

  .hero-mission :global(p + p) {
    margin-top: var(--space-4);
  }

  .hero :global(.ticker) {
    position: relative;
    z-index: 1;
  }

  .scroller {
    position: relative;
    z-index: 1;
    background: var(--bg);
  }

  /*
    Both sections sit in the same container every other page on the site
    uses, so the front page lines up with Stories and Journeys rather than
    running to the window edge on its own.
  */
  .section-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  /*
    The band the reader meets first coming off the photo, and the one place on
    the front page that genuinely breathes — via-design.md asks for the
    section rhythm to alternate density, and everything below this is tight.

    It is also the section the client marked for the topographic ground, so
    the pattern's one appearance on the homepage is here rather than spread
    across every plain surface.
  */
  .intro {
    position: relative;
    overflow: hidden;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    padding: var(--space-32) 0;
  }

  .intro-inner {
    position: relative;
    z-index: 1;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  /*
    Two columns, top-aligned. One column of this at the site's reading measure
    left two thirds of the band empty, which read as an unfinished section
    rather than as air. Side by side, the two paragraphs fill the width they
    are given and the band still breathes vertically.

    Each column keeps its own measure so neither runs past a comfortable line
    length on a wide screen.
  */
  .intro-inner {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-16);
    align-items: start;
  }

  .intro-inner :global(p) {
    max-width: 52ch;
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--fg);
  }

  @media (max-width: 860px) {
    .intro-inner {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }

  @media (max-width: 620px) {
    .intro {
      padding: var(--space-24) 0;
    }
  }

  .front-section {
    padding: var(--space-24) 0 var(--space-16);
  }

  /*
    The front block. Three columns of deliberately unequal weight — two
    secondary stories, the lead at half the page, then a rail of headlines —
    on a twelve-column grid so the proportions are stated as spans rather
    than guessed at in percentages.

    via-design.md: "Section rhythm alternates density." This is the tight
    section. The social band at the bottom of the page is the one that
    breathes.
  */
  .front {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--space-6);
    row-gap: var(--space-12);
  }

  .front-flank {
    grid-column: 1 / span 3;
    display: grid;
    align-content: start;
    gap: var(--space-12);
  }

  /*
    Hairlines, not gutters, separate the lead from its neighbours — at this
    density the whitespace alone stops reading as three columns and starts
    reading as seven loose cards.
  */
  .front-lead {
    grid-column: 4 / span 6;
    padding-inline: var(--space-6);
    border-inline: 1px solid var(--border);
  }

  .front-rail {
    grid-column: 10 / span 3;
    display: grid;
    align-content: start;
    gap: var(--space-6);
  }

  /*
    A rule between headlines, never above the first one — the section's own
    rule is already doing that job a few pixels higher.
  */
  .front-rail :global(.card + .card) {
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }

  /*
    With nothing to sit between, the lead takes the empty column's room
    rather than leaving a hole. Editors unfeature things; the page has to
    hold its shape when they do.
  */
  .front--no-flank .front-lead {
    grid-column: 1 / span 9;
    padding-inline-start: 0;
    border-inline-start: none;
  }

  .front--no-rail .front-lead {
    grid-column: 4 / span 9;
    padding-inline-end: 0;
    border-inline-end: none;
  }

  .front--no-flank.front--no-rail .front-lead {
    grid-column: 1 / -1;
    padding-inline: 0;
    border-inline: none;
  }

  .river-section {
    padding: 0 0 var(--space-24);
  }

  /*
    The river. Two letterbox stories open it, then everything else runs as
    ruled headlines — the same four columns throughout, so the change in
    weight comes from the cards and not from the grid moving underneath them.
  */
  .river-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    column-gap: var(--space-6);
    row-gap: var(--space-12);
  }

  .river-grid > :global(.card--wide) {
    grid-column: span 2;
  }

  .river-grid > :global(.card--compact) {
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
  }

  @media (max-width: 1100px) {
    /*
      Not enough width for three columns of type. The lead goes over the top
      at full width and the other two groups stack beneath it, which keeps
      the reading order the same as the desktop layout's.
    */
    .front {
      grid-template-columns: repeat(2, 1fr);
    }

    .front-lead {
      order: -1;
      grid-column: 1 / -1;
      padding-inline: 0;
      border-inline: none;
    }

    .front-flank,
    .front-rail {
      grid-column: 1 / -1;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-8) var(--space-6);
    }

    /* Side by side, a rule on every headline but the first reads as an
       error. Rule all of them instead. */
    .front-rail :global(.card) {
      padding-top: var(--space-6);
      border-top: 1px solid var(--border);
    }

    .river-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 900px) {
    .river-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 620px) {
    .front,
    .front-flank,
    .front-rail,
    .river-grid {
      grid-template-columns: 1fr;
    }

    .river-grid > :global(.card--wide) {
      grid-column: span 1;
    }
  }

  .social {
    background: var(--surface);
    border-top: 1px solid var(--border);
    padding: var(--space-24) var(--gutter);
  }

  .social-inner {
    max-width: 48ch;
    margin: 0 auto;
    text-align: center;
  }

  .social-eyebrow {
    margin: 0 0 var(--space-2);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--muted);
  }

  .social-message {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--fg);
  }
</style>
