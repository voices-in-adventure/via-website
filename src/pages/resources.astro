---
// Resources: the things mentioned inside stories, pulled out and gathered.
//
// via-design.md scopes this section wider than products — maps, emergency
// information, checklists — but products are the only strand the content
// model supports today. The rest are named at the foot as what is coming
// rather than built as empty links. anti-slop.md rules out visible
// placeholder furniture; naming an unbuilt section honestly is not that.
import PageLayout from '../layouts/PageLayout.astro'
import SectionHead from '../components/SectionHead.astro'
import ProductCard from '../components/ProductCard.astro'
import EmptyState from '../components/EmptyState.astro'
import HandRule from '../components/HandRule.astro'
import {sanityClient} from '../lib/sanity'
import {byMentions, PRODUCTS_QUERY, type Product} from '../lib/products'

const [products, settings] = await Promise.all([
  sanityClient.fetch<Product[]>(PRODUCTS_QUERY),
  sanityClient.fetch<{pitchUsUrl?: string | null} | null>(
    `*[_type == "siteSettings"][0]{pitchUsUrl}`,
  ),
])

// Most-written-about first, so the preview is the six things VIA keeps
// coming back to rather than the six that happen to sort first.
const preview = [...products].sort(byMentions).slice(0, 6)

const strands = [
  {
    title: 'Maps',
    body: 'Some of our detailed routes.',
  },
  {
    title: 'Emergency Information',
    body: 'What we’ve done when a trip went wrong.',
  },
  {
    title: 'Checklists',
    body:
      'The unexpected things to sort out. For example, before getting your visa, or hopping on a night bus.',
  },
]
---

<PageLayout
  title="Resources"
  standfirst="We’ve collated all the tools our writers have found helpful across their many travels, and we think you’ll be able to put them to good use too. You can click on a particular resource to see the pieces it’s been mentioned in, and get a better idea of how and where best to use it."
>
  <section class="products">
    <div class="products-inner">
      <SectionHead
        title="Products"
        note="From the smallest lip balm to backpacks that double as cushions, every item here comes recommended by VIA’s own community of travelers. You’ll find that these are the things we’ve packed, carried, tested, and found practical in some unconventional ways."
        actionLabel="View all products"
        actionHref={products.length > 0 ? '/resources/products' : null}
      />

      {
        preview.length > 0 ? (
          <div class="products-grid">
            {preview.map((product) => (
              <ProductCard product={product} />
            ))}
          </div>
        ) : (
          <EmptyState
            title="No products yet"
            body="Products appear here as soon as a published story references one. Nothing has been filed yet, so there is nothing to gather."
            actionLabel="Pitch us a story"
            actionHref={settings?.pitchUsUrl}
          />
        )
      }

      <p class="independence">
        No featured product is included by request of a brand, through sponsorship, or to earn
        affiliate income.
      </p>
    </div>
  </section>

  <section class="strands">
    <div class="strands-inner">
      <HandRule />
      <h2 class="strands-heading">Coming soon</h2>
      <p class="strands-note">Keep an eye out!</p>
      <dl class="strands-list">
        {
          strands.map((strand) => (
            <div class="strand">
              <dt class="strand-title">{strand.title}</dt>
              <dd class="strand-body">{strand.body}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>
</PageLayout>

<style>
  .products-inner,
  .strands-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .products {
    padding-bottom: var(--space-24);
  }

  /*
    The independence claim. Set quiet and small on purpose — it is a
    disclosure, not a selling point, and a page that shouts about its own
    integrity is doing the opposite of demonstrating it.
  */
  .independence {
    max-width: var(--measure);
    margin: var(--space-12) 0 0;
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    line-height: 1.6;
    color: var(--muted);
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-12) var(--space-8);
  }

  /*
    The dense counterweight to the section above: no images, no cards, three
    short lines set at the reading measure.
  */
  .strands {
    padding: var(--space-16) 0 var(--space-24);
    background: var(--surface);
  }

  .strands-heading {
    margin: 0;
    padding-top: var(--space-4);
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 500;
    line-height: 1.2;
    color: var(--fg);
  }

  .strands-note {
    max-width: var(--measure);
    margin: var(--space-2) 0 var(--space-8);
    font-family: var(--font-serif);
    font-size: var(--text-base);
    line-height: 1.5;
    color: var(--muted);
  }

  .strands-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
    max-width: 1000px;
    margin: 0;
  }

  .strand-title {
    margin: 0 0 var(--space-2);
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--fg);
  }

  .strand-body {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-base);
    line-height: 1.5;
    color: var(--muted);
  }

  @media (max-width: 1000px) {
    .products-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 760px) {
    .strands-list {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  @media (max-width: 620px) {
    .products-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
