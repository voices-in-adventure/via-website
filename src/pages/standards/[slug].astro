---
// One section of the Code of Ethics.
//
// Same plain reading register as the index: a single column, no photography.
// The six sections are one document read in order, so this page carries
// previous/next rather than sending the reader back to the index each time.
import PageLayout from '../../layouts/PageLayout.astro'
import PortableBody from '../../components/PortableBody.astro'
import HandRule from '../../components/HandRule.astro'
import {sanityClient} from '../../lib/sanity'
import type {PortableTextBlock} from 'astro-portabletext/types'

interface Policy {
  title: string
  slug: string
  order: number
  summary: string
  body: PortableTextBlock[]
}

export async function getStaticPaths() {
  const policies = await sanityClient.fetch<Policy[]>(
    `*[_type == "policy" && defined(slug.current)] | order(order asc){
      title, "slug": slug.current, order, summary, body
    }`,
  )

  return policies.map((policy, index) => ({
    params: {slug: policy.slug},
    props: {
      policy,
      total: policies.length,
      previous: policies[index - 1] ?? null,
      next: policies[index + 1] ?? null,
    },
  }))
}

interface Props {
  policy: Policy
  total: number
  previous: Policy | null
  next: Policy | null
}

const {policy, total, previous, next} = Astro.props
---

<PageLayout title={policy.title} eyebrow="Standards and Ethics" description={policy.summary}>
  <div class="policy">
    <p class="position">Section {policy.order} of {total}</p>

    <PortableBody value={policy.body} />

    <nav class="continue" aria-label="Other sections">
      <HandRule weight="hairline" />
      <div class="continue-row">
        {
          previous ? (
            <a class="continue-link" href={`/standards/${previous.slug}`}>
              <span class="continue-label">Previous</span>
              <span class="continue-title">{previous.title}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a class="continue-link continue-link--next" href={`/standards/${next.slug}`}>
              <span class="continue-label">Next</span>
              <span class="continue-title">{next.title}</span>
            </a>
          )
        }
      </div>
      <p class="all-sections">
        <a href="/standards">All {total} sections</a>
      </p>
    </nav>
  </div>
</PageLayout>

<style>
  .policy {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  /*
    Mono, matching the ticker's data voice and the numbering on the index.
    This is positional information, not prose.
  */
  .position {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 var(--space-8);
  }

  .continue {
    margin-top: var(--space-24);
  }

  /*
    Previous left, next right, even when there is only one of them — an empty
    grid cell holds the position so the last section's "next" does not slide
    under the left margin.
  */
  .continue-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
    margin-top: var(--space-6);
  }

  .continue-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .continue-link--next {
    text-align: right;
  }

  .continue-label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .continue-title {
    display: block;
    margin-top: var(--space-2);
    font-family: var(--font-serif);
    font-size: var(--text-base);
    line-height: 1.3;
  }

  .continue-link:hover .continue-title,
  .continue-link:focus-visible .continue-title {
    color: var(--accent);
  }

  .all-sections {
    margin: var(--space-12) 0 0;
    font-size: var(--text-sm);
  }

  .all-sections a {
    color: var(--muted);
  }

  .all-sections a:hover,
  .all-sections a:focus-visible {
    color: var(--accent);
  }

  @media (max-width: 620px) {
    .continue-row {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .continue-link--next {
      text-align: left;
    }
  }
</style>
